{
  "name": "wdio-cucumber-lambdatest",
  "version": "1.0.0",
  "description": "WebdriverIO + Cucumber framework for LambdaTest mobile automation (iOS/Android app & web)",
  "main": "index.js",
  "scripts": {
    "android:app:single": "wdio run ./wdio.android.app.single.conf.ts",
    "android:app:parallel": "wdio run ./wdio.android.app.parallel.conf.ts",
    "ios:app:single": "wdio run ./wdio.ios.app.single.conf.ts",
    "ios:app:parallel": "wdio run ./wdio.ios.app.parallel.conf.ts",
    "android:web": "wdio run ./wdio.android.web.conf.ts",
    "ios:web": "wdio run ./wdio.ios.web.conf.ts"
  },
  "keywords": [
    "webdriverio",
    "wdio",
    "cucumber",
    "lambdatest",
    "appium",
    "mobile",
    "automation"
  ],
  "author": "",
  "license": "MIT",
  "type": "commonjs",
  "devDependencies": {
    "@types/node": "^25.8.0",
    "@wdio/appium-service": "^9.27.1",
    "@wdio/cli": "^9.27.1",
    "@wdio/cucumber-framework": "^9.27.1",
    "@wdio/globals": "^9.27.1",
    "@wdio/local-runner": "^9.27.1",
    "@wdio/spec-reporter": "^9.27.1",
    "@wdio/types": "^9.27.1",
    "appium": "^3.4.2",
    "appium-uiautomator2-driver": "^7.4.0",
    "expect-webdriverio": "^5.6.5",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^6.0.3",
    "webdriverio": "^9.27.1"
  }
}
